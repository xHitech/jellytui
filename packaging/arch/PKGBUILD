# Maintainer: Hitech <184116371+xHitech@users.noreply.github.com>

pkgname=jellytui
pkgver=0.1.0
pkgrel=1
pkgdesc="Reprodutor de música Jellyfin para terminal, com Textual e mpv"
arch=('any')
url="https://github.com/xHitech/jellytui"
license=('MIT')
depends=(
    'mpv'
    'python'
    'python-httpx'
    'python-textual'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/xHitech/jellytui/archive/refs/tags/v$pkgver.tar.gz"
    "LICENSE::https://raw.githubusercontent.com/xHitech/jellytui/c9928f74dd4c29c7aef35afc055318a9ae75c997/LICENSE"
)
sha256sums=(
    '3e2b95b3f888daedded51a7c91e9402ff809112b351247243a9990183df0d2e2'
    '5ecee4bd16c15c8edd43c8a8552405ca3e918ec93403000fab0fdc3c6d17d1ca'
)

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    else
        install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
